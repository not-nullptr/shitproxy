UPSTREAM_URL=https://your-router.example/v1
UPSTREAM_API_KEY=replace-with-your-upstream-key
GATEWAY_API_KEY=replace-with-a-separate-client-key
# Entire request / generation deadline, including streaming. No automatic retries.
UPSTREAM_TIMEOUT_MS=600000
# Temporary prompt-prefix diagnostics: keyed fingerprints and token counts only.
# No prompt previews, credentials, signatures or tool arguments are logged.
DEBUG_CACHE=0

# Personal Kagi auth for local search on non-Anthropic/non-OpenAI models.
KAGI_SESSION=
# Optional challenge cookie, only if required by your Kagi session.
KAGI_TURNSTILE=
