UPSTREAM_URL=https://your-router.example/v1
UPSTREAM_API_KEY=replace-with-your-upstream-key
GATEWAY_API_KEY=replace-with-a-separate-client-key
# Optional, multi-tenant: an internal service that maps each caller's own key to
# the upstream key their request should use. With this set, resolution replaces
# the upstream credential per request and is authoritative — UPSTREAM_API_KEY is
# no longer used as a fallback, so an unrecognised caller is refused instead of
# spending the operator's key. See "Per-request credential resolution" in the README.
UPSTREAM_KEY_RESOLVER_URL=
# Shared secret sent to that service as X-Gateway-Secret, when it expects one.
GATEWAY_RESOLVER_SECRET=
# Entire request / generation deadline, including streaming. No automatic retries.
UPSTREAM_TIMEOUT_MS=600000
# Temporary prompt-prefix diagnostics: keyed fingerprints and token counts only.
# No prompt previews, credentials, signatures or tool arguments are logged.
DEBUG_CACHE=0

# Personal Kagi auth for local search on non-Anthropic/non-OpenAI models.
KAGI_SESSION=
# Optional challenge cookie, only if required by your Kagi session.
KAGI_TURNSTILE=
